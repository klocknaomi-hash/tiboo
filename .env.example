# ── Supabase (Database & Authentication) ────────────────────────────────
# Project Settings → API. These two are safe to ship in the client bundle,
# which is why they need the EXPO_PUBLIC_ prefix (Expo only inlines vars
# that start with EXPO_PUBLIC_ into the app).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (AI Agent) ────────────────────────────────────────────────────
# platform.openai.com → API keys. Server-only: used in src/app/api routes,
# never prefix this with EXPO_PUBLIC_ or it leaks into the client bundle.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Browserbase + Stagehand (web browsing tool) ─────────────────────────
# browserbase.com dashboard → Settings. Server-only, same reason as above.
# Inscription gratuite : dcmk.short.gy/browserbase-free-sdk
BROWSERBASE_API_KEY=bb_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Mode Développement (Bypass Google Auth) ──────────────────────────────
# Permet d'afficher le bouton "Continuer sans compte" pour tester sans Google OAuth.
# En production, ce bouton ne s'affichera JAMAIS (protégé par __DEV__).
EXPO_PUBLIC_DEV_ANON_LOGIN=true


