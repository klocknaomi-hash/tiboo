# =============================================================================
# Tiboo — environment variables
# Copy to .env (never commit .env). Only EXPO_PUBLIC_* values reach the app;
# everything else stays on the server (Expo Router API routes in src/app/api).
# =============================================================================

# ── App (public) ─────────────────────────────────────────────────────────────
# Supabase → Project Settings → API (URL + anon key are safe in the app)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Address of the deployed Tiboo server, used by the iOS/Android app
# (e.g. https://tiboo.expo.app after `eas deploy`). Not needed on the web.
EXPO_PUBLIC_API_URL=
# Development only: shows "Continuer sans compte" (never in production builds).
EXPO_PUBLIC_DEV_ANON_LOGIN=false

# ── Server: Supabase ─────────────────────────────────────────────────────────
# Service role key: ONLY used by the scheduled-task runner. Never EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Server: security ─────────────────────────────────────────────────────────
# Random string, 32+ characters (signs actions waiting for confirmation).
TIBOO_SERVER_SECRET=
# Shared secret between the Supabase cron function and this server
# (set the same value with `supabase secrets set TIBOO_CRON_SECRET=...`).
TIBOO_CRON_SECRET=
# Messages per user per hour (cost limit).
TIBOO_MAX_MESSAGES_PER_HOUR=30

# ── Server: AI ───────────────────────────────────────────────────────────────
# openai (default, the only provider that can use connectors) | anthropic | grok
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional, conversation only (no connectors):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
XAI_API_KEY=
GROK_MODEL=

# ── Server: connectors (Composio) ────────────────────────────────────────────
COMPOSIO_API_KEY=
# Optional pinned toolkit versions, e.g. {"gmail":"20250909_00"}
COMPOSIO_TOOLKIT_VERSIONS=

# ── Server: web browsing (optional, otherwise plain page reading) ────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
